{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "products"
  ],
  "properties": {
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "slug",
          "displayName",
          "branding",
          "roles",
          "redirectURIs"
        ],
        "additionalProperties": false,
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}$"
          },
          "displayName": {
            "type": "string",
            "minLength": 1
          },
          "branding": {
            "type": "object",
            "required": [
              "Accent",
              "AccentDark"
            ],
            "properties": {
              "Product": {
                "type": "string"
              },
              "Logo": {
                "type": "string"
              },
              "Accent": {
                "type": "string",
                "pattern": "^#[A-Fa-f0-9]{6}$"
              },
              "AccentDark": {
                "type": "string",
                "pattern": "^#[A-Fa-f0-9]{6}$"
              },
              "PrivacyURL": {
                "type": "string"
              },
              "TermsURL": {
                "type": "string"
              }
            }
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "redirectURIs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "anyOf": [
                {
                  "format": "uri"
                },
                {
                  "pattern": "\\{\\{.+\\}\\}"
                }
              ]
            }
          },
          "postLogoutRedirects": {
            "type": "array",
            "items": {
              "type": "string",
              "anyOf": [
                {
                  "format": "uri"
                },
                {
                  "pattern": "\\{\\{.+\\}\\}"
                }
              ]
            }
          },
          "groupRoles": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "database": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "instances": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "signin": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 2
        },
        "requireTOTP": {
          "type": "boolean"
        }
      }
    }
  }
}
